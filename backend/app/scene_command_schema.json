{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://worldcraft.ai/schemas/scene_command.json",
  "title": "SceneCommand",
  "description": "A structured set of actions to mutate the WorldCraft scene.",
  "type": "object",
  "required": ["actions"],
  "additionalProperties": false,
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/SceneAction" }
    }
  },
  "$defs": {
    "SceneAction": {
      "type": "object",
      "required": ["action_type"],
      "oneOf": [
        { "$ref": "#/$defs/AddObject" },
        { "$ref": "#/$defs/MoveObject" },
        { "$ref": "#/$defs/RemoveObject" },
        { "$ref": "#/$defs/ModifyObject" }
      ]
    },
    "AddObject": {
      "type": "object",
      "required": ["action_type", "asset_id", "label", "position"],
      "additionalProperties": false,
      "properties": {
        "action_type": { "type": "string", "const": "add_object" },
        "asset_id":    { "type": "string" },
        "label":       { "type": "string", "maxLength": 64 },
        "position":    { "$ref": "#/$defs/Vec3" },
        "rotation_y":  { "type": "number" },
        "scale":       { "type": "number", "minimum": 0.1, "maximum": 10.0 }
      }
    },
    "MoveObject": {
      "type": "object",
      "required": ["action_type", "target_label", "position"],
      "additionalProperties": false,
      "properties": {
        "action_type":  { "type": "string", "const": "move_object" },
        "target_label": { "type": "string" },
        "position":     { "$ref": "#/$defs/Vec3" },
        "rotation_y":   { "type": "number" }
      }
    },
    "RemoveObject": {
      "type": "object",
      "required": ["action_type", "target_label"],
      "additionalProperties": false,
      "properties": {
        "action_type":  { "type": "string", "const": "remove_object" },
        "target_label": { "type": "string" }
      }
    },
    "ModifyObject": {
      "type": "object",
      "required": ["action_type", "target_label"],
      "additionalProperties": false,
      "properties": {
        "action_type":  { "type": "string", "const": "modify_object" },
        "target_label": { "type": "string" },
        "scale":        { "type": "number", "minimum": 0.1, "maximum": 10.0 }
      }
    },
    "Vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
